❓ Question
Check whether a given number is prime or not.
Take a number t as input → total number of test cases
For each test case, take a number n as input
Print prime if n is prime, otherwise print not prime

📥 Input Format

t
n
n
... (t times)
📤 Output Format
prime
not prime
not prime
... (t times)

📏 Constraints
1 <= t <= 10000
2 <= n < 10^9

ANS.
import java.util.Scanner;
public class input {
    public static void main(String [] args) {
        Scanner scn = new Scanner(System.in);
        int t = scn.nextInt();
        for(int i = 1 ; i <= t ; i++) {
            int n = scn.nextInt();
            int count = 0;
            for(int j = 2 ; j*j <= n ; j++) {
                if(n % j == 0) {
                   count++;
                   break;
                }
            }
            if(count == 0) {
                System.out.println(n+" is a prime number");
            } 
            else {
                System.out.println(n+" is not a prime number");
            }
           
        }
    }
}
