Print all Prime Numbers till N 



import java.util.Scanner;
public class input {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int a = scn.nextInt();
        int b = scn.nextInt();
        for(int i=a; i<=b;i++) {
            int count = 0;
            for(int j=2 ; j*j<=i ; j++) {
                if(i%j == 0){
                    count++;
                    break;
                }
            }
            if(count == 0) {
                System.out.println(i+" is a prime number ");
            }
           
        }
        scn.close();
    }
}










