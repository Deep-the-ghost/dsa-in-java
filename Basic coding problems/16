Reverse a number  


import java.util.Scanner;
public class input {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();


        int nod = 0;
        int temp = n;
        while(temp > 0 ){
            nod++;
            temp = temp/10;
        }


        for (int i = 0 ; i != nod ; i++){
            int rem = n%10;
            System.out.println(rem);
            n=n/10;
        }


    }
}


