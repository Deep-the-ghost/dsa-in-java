Q) TAKE INPUT A NUMBER AND PRINT 0 TO THE NUMBER.

import java.util.Scanner;
public class input{
    public static void main(String[] args){
       Scanner scn = new Scanner(System.in);
    int n = scn.nextInt();
    for(int i=0;i<=n;i++){
        System.out.println(i);
    }  
    scn.close();
    }
}
