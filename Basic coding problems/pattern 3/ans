import java.util.Scanner;

public class ans {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Enter the number of lines: ");
        int n = scanner.nextInt();
        for(int i = 1;i <= n; i++) {
            for (int k = n- i; k >= 1; k--){
                System.out.print("  ");

            }
            for(int j = 1; j <=i ; j++){
                System.out.print("* ");
            }
            System.out.println();

        }
    }
}
