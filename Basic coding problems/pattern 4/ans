import java.util.Scanner;

public class ans{
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Enter the number of lines");
        int n = scanner.nextInt();
        for(int i=n; i >= 1; i--){
            for(int j=n-i; j >= 1 ; j--){
                System.out.print("  ");
            } 
            for (int k=i; k >= 1; k--){
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
